# Build de producción (GitHub Pages). Valores públicos del frontend.
# El build de CI (GitHub Actions) inyecta estas variables desde las Variables
# del repo y tienen prioridad sobre este archivo.
# Backend real (Render). Sin esto, el build queda apuntando a 127.0.0.1:8000.
VITE_API_URL=https://hefestotech.onrender.com
# En GitHub Pages se sirve desde /hefestotech/ (default de vite.config.js).
VITE_BASE=/hefestotech/
