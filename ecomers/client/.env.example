# HefestoTech · ecomers/client/.env.example
# Copiar a ecomers/client/.env (o .env.local) y rellenar con valores reales
# (ese archivo NO se versiona). Valores vacíos = a completar por el dueño.
# Proyecto Supabase (ver Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://ewqwmzwtrsjlrrnrotcm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
# Backend propio (checkout real, estado de pedidos, comprobantes)
VITE_API_URL=http://127.0.0.1:8000
# Producción:
# VITE_API_URL=https://tu-backend.fly.dev

# Modo demo: catálogo local de solo lectura (src/demo), sin cuentas ni pagos.
# Se activa solo en `npm run dev` si faltan las credenciales de Supabase,
# o a mano con VITE_DEMO=1 (`npm run dev:demo`). Nunca en producción real.
# VITE_DEMO=1
