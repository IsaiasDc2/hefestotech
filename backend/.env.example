# HefestoTech · backend/.env.example
# Copiar a backend/.env y completar. NUNCA commitear el .env real.
# Valores vacíos = a completar por el dueño. NO inventar.

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SOLO backend. Nunca exponer en frontend (bypasea RLS).

# Mercado Pago (https://www.mercadopago.com.ar/developers → Tus integraciones)
MERCADOPAGO_ACCESS_TOKEN=
# Access Token de PRODUCCIÓN (empieza con APP_USR-). Para pruebas usar uno de prueba.
MP_WEBHOOK_SECRET=
# Secreto para validar firma x-signature del webhook.

# URLs públicas (sin barra final)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
# En producción: FRONTEND_URL=https://isaiasdc2.github.io/hefestotech
#                BACKEND_URL=https://tu-backend.fly.dev (o donde se deploye)

# Datos del comercio para el comprobante (vacío = a completar, NO inventar)
TIENDA_NOMBRE=
TIENDA_CUIT=
TIENDA_DIRECCION=
TIENDA_EMAIL=
TIENDA_TELEFONO=

# Email de comprobantes (vacío = email desactivado, ver README del módulo)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Asistente de IA (backend/asistente). La clave vive SOLO acá, nunca en el front.
# LLM_PROVIDER: mock (sin clave ni internet: respuestas determinísticas con el
# catálogo real) | gemini. Vacío = gemini si hay clave, mock si no.
LLM_PROVIDER=mock
LLM_API_KEY=
# Vacío = gemini-3.5-flash. Para otro modelo: gemini-3.5-flash-lite (más barato
# y rápido) o el que prefieras de la lista de tu clave.
LLM_MODEL=
# Compatibilidad: si solo están GEMINI_API_KEY / GEMINI_MODEL, se usan esos
# (si GEMINI_MODEL apunta a un modelo lento, el asistente cae al fallback).
# Límite de tokens de salida, timeout por llamada (s) y rate limit (req/min).
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT_SEG=20
ASSISTANT_RATE_LIMIT_PER_MIN=20
# ASSISTANT_RATE_LIMIT_SESSION_PER_MIN=10
# Datos del asistente: supabase (con SUPABASE_*) | demo (catálogo de
# ecomers/client/src/demo + pedidos demo). Vacío = supabase si está configurado.
# ASISTENTE_DATOS=

# Opcional (ya existentes)
# CORS_EXTRA_ORIGINS=https://tu-front.vercel.app
# Lista separada por comas de orígenes extra (Vercel, preview).

# Secreto propio del liberador de órdenes expiradas (cron). Si falta, se usa
# MP_WEBHOOK_SECRET como fallback; sin ninguno de los dos, no se ejecuta.
# CRON_SECRET=

# Render/proxy: confiar en X-Forwarded-For para que el rate-limit vea la IP
# real (Render lo setea; el backend no es alcanzable saltando el proxy).
# En Render se configura FORWARDED_ALLOW_IPS=* (ver render.yaml).
# FORWARDED_ALLOW_IPS=*

# Desarrollo local: habilitar /docs y los flags de entorno en la raíz.
# MOSTRAR_DOCS=1
# MOSTRAR_ENV=1
